// ============================================================================
// BUSAN HAK PORT INFO — Copyright (c) 2026 이춘학 (luxrank@gmail.com). All rights reserved.
// 사유 소프트웨어입니다. 저작권자의 사전 서면 동의 없이 복제·배포·수정·2차적 저작물 작성·
// 역분석·디컴파일을 할 수 없습니다. 자세한 내용은 저장소의 LICENSE 파일을 참고하세요.
// ============================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------
    // 0. Global Safety Net (Default Deny)
    // ---------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // 1. Hardened Helper Functions
    // ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-가-힣.]+$');
    }

    function isSha256Hash(val) {
      return val is string && val.size() == 64 && val.matches('^[a-fA-F0-9]{64}$');
    }

    // 소프트 삭제(되돌릴 수 있는 삭제)만 허용하는 형태 검사.
    // 물리 삭제(delete)는 관리자 전용이므로, 작성자·관리자의 삭제 요청은 이 경로를 씁니다.
    function isValidSoftDelete() {
      return resource != null &&
        incoming().diff(existing()).affectedKeys().hasOnly(['deletedAt', 'deletedBy']) &&
        incoming().deletedAt is timestamp &&
        (!('deletedBy' in incoming().diff(existing()).affectedKeys()) ||
          (incoming().deletedBy is string && incoming().deletedBy.size() <= 64));
    }

    function isValidBoardPost(data) {
      return data.nick is string && data.nick.size() <= 50 &&
        data.title is string && data.title.size() <= 200 &&
        data.content is string && data.content.size() <= 10000 &&
        isSha256Hash(data.password);
    }

    function isValidBoardComment(data) {
      return data.name is string && data.name.size() <= 50 &&
        data.text is string && data.text.size() <= 2000 &&
        isSha256Hash(data.password) &&
        (!('imageUrl' in data) || data.imageUrl == null ||
          (data.imageUrl is string && data.imageUrl.size() <= 2000));
    }

    // 앱이 자동 등록하는 업데이트 공지 문서 ID (화면 코드와 반드시 일치해야 합니다)
    function isAutoNoticeId(id) {
      return id == 'update_2026_10_04_v2027' || id == 'update_2026_10_10_hak_port_ver2';
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid in ['admin_luxrank', 'luxrank_admin_uid'] ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'luxrank@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ---------------------------------------------------------
    // 2. settings Collection
    //    - settings/admin: 클라이언트 읽기·쓰기 완전 차단 (비밀번호 유출 원천 봉쇄)
    //    - 티커 및 식단표 문서: 익명 인증 이상 조회 가능, 관리자만 수정
    // ---------------------------------------------------------
    match /settings/admin {
      allow read, write: if false;
    }

    match /settings/{settingId} {
      allow get: if isSignedIn() && settingId != 'admin' && isValidId(settingId);
      allow list: if false;
      allow create, update: if isSignedIn() && settingId != 'admin' && isValidId(settingId) && (
        isAdmin() ||
        (settingId == 'banner' && incoming().diff(existing()).affectedKeys().hasOnly(['userMessages']) && incoming().userMessages is list && incoming().userMessages.size() <= 3)
      );
      allow delete: if isAdmin() && settingId != 'admin';
    }

    // ---------------------------------------------------------
    // 3. admins Collection (관리자 UID 화이트리스트)
    // ---------------------------------------------------------
    match /admins/{adminUid} {
      allow get: if isSignedIn() && request.auth.uid == adminUid;
      allow list: if false;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------
    // 4. visitor_stats Collection
    //    - 읽기: 인증된 세션 허용
    //    - 쓰기(create/update): count 및 unique는 감소 불가(증가만 허용), 삭제(delete) 완전 금지
    // ---------------------------------------------------------
    function isValidVisitorStatWrite() {
      return (!('count' in incoming()) || (
        incoming().count is int &&
        incoming().count >= (resource == null || !('count' in existing()) ? 0 : existing().count) &&
        incoming().count <= (resource == null || !('count' in existing()) ? 10000 : existing().count + 5)
      )) &&
      (!('unique' in incoming()) || (
        incoming().unique is int &&
        incoming().unique >= (resource == null || !('unique' in existing()) ? 0 : existing().unique) &&
        incoming().unique <= (resource == null || !('unique' in existing()) ? 10000 : existing().unique + 5)
      ));
    }

    match /visitor_stats/{statId} {
      allow get: if isSignedIn() && isValidId(statId);
      allow list: if false;
      allow create, update: if isSignedIn() && isValidId(statId) && isValidVisitorStatWrite();
      allow delete: if false;
    }

    // ---------------------------------------------------------
    // 5. user_profiles Collection
    //    - 전체 목록(list) 조회 금지 (단건 get만 허용하여 계정·비번 덤프 차단)
    //    - 생성·수정 시 SHA-256 해시(64자 hex)만 허용 (평문 저장 원천 차단)
    // ---------------------------------------------------------
    match /user_profiles/{nick} {
      allow get: if isSignedIn() && isValidId(nick);
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(nick) && (
        (
          incoming().keys().hasAll(['password', 'createdAt']) &&
          incoming().keys().hasOnly(['password', 'createdAt', 'fcmToken', 'updatedAt']) &&
          isSha256Hash(incoming().password)
        ) || (
          incoming().keys().hasOnly(['fcmToken', 'updatedAt']) &&
          incoming().fcmToken is string && incoming().fcmToken.size() <= 1024
        )
      );
      allow update: if isSignedIn() && isValidId(nick) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['password', 'fcmToken', 'updatedAt']) &&
        (!('password' in incoming().diff(existing()).affectedKeys()) || isSha256Hash(incoming().password)) &&
        (!('fcmToken' in incoming()) || incoming().fcmToken == null || (incoming().fcmToken is string && incoming().fcmToken.size() <= 1024));
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // 6. work_logs Collection (근무일지)
    //    - 인증된 사용자만 본인의 workerId 조건으로 조회/저장/삭제
    // ---------------------------------------------------------
    match /work_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId);
      // 목록 조회는 workerId 조건을 증명할 수 있어야 허용됩니다(규칙은 필터가 아닙니다).
      // 화면은 본인 workerId 로만 조회하며, 실제 관리자(로그인 계정)는 전체를 볼 수 있습니다.
      allow list: if isSignedIn() && (
        isAdmin() ||
        (resource.data.workerId is string && resource.data.workerId.size() <= 64)
      );
      allow create: if isSignedIn() && isValidId(logId) &&
        incoming().workerId is string && incoming().workerId.size() >= 1 && incoming().workerId.size() <= 64 &&
        incoming().date is string && incoming().date.size() == 10;
      // 갱신: 소유자(workerId)·날짜를 바꿔치기할 수 없습니다 (다른 사람 일지로 옮기기 차단).
      allow update: if isSignedIn() && isValidId(logId) &&
        incoming().workerId is string && incoming().workerId.size() >= 1 && incoming().workerId.size() <= 64 &&
        incoming().date is string && incoming().date.size() == 10 &&
        incoming().workerId == existing().workerId &&
        incoming().date == existing().date;
      // 물리 삭제는 관리자만. 화면의 '삭제'는 deletedAt 소프트 삭제로 동작하며 관리자가 복구할 수 있습니다.
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // 7. hjnc_schedules Collection (터미널 선석 스케줄 캐시)
    // ---------------------------------------------------------
    match /hjnc_schedules/{schedId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(schedId);
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // 8. notices, posts, ships, archives, leader_overrides
    //    - 조회수(views) 단건 증가(중복 조회 포함)는 인증된 세션 누구나 허용
    // ---------------------------------------------------------
    function isValidViewCountIncrement() {
      return resource != null &&
        incoming().diff(existing()).affectedKeys().hasOnly(['views']) &&
        incoming().views is int &&
        incoming().views == ((!('views' in existing()) || !(existing().views is int)) ? 1 : existing().views + 1);
    }

    match /notices/{noticeId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || isAutoNoticeId(noticeId));
      allow update: if isSignedIn() && (isAdmin() || isAutoNoticeId(noticeId) || isValidViewCountIncrement());
      allow delete: if isAdmin();
    }

    match /posts/{postId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(postId) && isValidBoardPost(incoming());
      // 내용 수정은 비밀번호를 바꾸지 못합니다(비밀번호 선점·잠금 공격 차단). 삭제는 소프트 삭제만.
      allow update: if isSignedIn() && isValidId(postId) && (
        isValidViewCountIncrement() ||
        (isValidBoardPost(incoming()) && incoming().password == existing().password) ||
        isValidSoftDelete()
      );
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(commentId) && isValidBoardComment(incoming());
        allow update: if isSignedIn() && isValidId(commentId) && (
          (isValidBoardComment(incoming()) && incoming().password == existing().password) ||
          isValidSoftDelete()
        );
        allow delete: if isAdmin();
      }
    }

    match /ships/{shipId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(shipId) &&
        incoming().shipName is string && incoming().shipName.size() <= 120 &&
        isSha256Hash(incoming().password);
      allow update: if isSignedIn() && isValidId(shipId) && (
        isValidViewCountIncrement() ||
        (incoming().shipName is string && incoming().shipName.size() <= 120 &&
          isSha256Hash(incoming().password) && incoming().password == existing().password) ||
        isValidSoftDelete()
      );
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(commentId) && isValidBoardComment(incoming());
        allow update: if isSignedIn() && isValidId(commentId) && (
          (isValidBoardComment(incoming()) && incoming().password == existing().password) ||
          isValidSoftDelete()
        );
        allow delete: if isAdmin();
      }
    }

    match /archives/{archiveId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(archiveId);
      allow delete: if isAdmin();
    }

    match /leader_overrides/{dateId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // 9. notifications & vessel_schedules_cache (자동화 알림 및 스케줄 캐시)
    // ---------------------------------------------------------
    match /notifications/{notiId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(notiId) &&
        incoming().userId is string && incoming().userId.size() <= 64 &&
        incoming().title is string && incoming().title.size() <= 200 &&
        incoming().body is string && incoming().body.size() <= 2000;
      allow update: if isSignedIn() && isValidId(notiId) && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['read', 'readAt'])
      );
      allow delete: if isAdmin();
    }

    match /vessel_schedules_cache/{vslId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
