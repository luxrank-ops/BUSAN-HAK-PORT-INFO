{
  "name": "busan-hak-port-info",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run typecheck && npm run build:obfuscate",
    "build:obfuscate": "node scripts/build-obfuscate.mjs",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "inspection": "node scripts/daily-inspection.mjs",
    "selfcheck": "node scripts/weekly-self-check-run.mjs",
    "tokens:apply": "node scripts/apply-design-tokens.mjs",
    "tokens:check": "node scripts/apply-design-tokens.mjs --check",
    "tokens:docs": "node scripts/apply-design-tokens.mjs --docs",
    "test": "node --test scripts/*.test.mjs",
    "test:rules": "node scripts/rules/run-rules-tests.mjs",
    "check": "npm run typecheck && npm run validate && npm run tokens:check && npm test",
    "lint": "npm run check"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "dotenv": "^18.0.7",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.34.0",
    "js-yaml": "^4.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
