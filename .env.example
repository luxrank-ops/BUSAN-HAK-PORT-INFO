# Firebase Configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=busan-hak-port.firebaseapp.com
FIREBASE_PROJECT_ID=busan-hak-port
FIREBASE_STORAGE_BUCKET=busan-hak-port.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=616469111502
FIREBASE_APP_ID=1:616469111502:web:6f3c94b15e444e04c7669f
FIREBASE_MEASUREMENT_ID=G-QQ728TDFJ2


# --- 추가 알림 시스템 변수 (직접 등록 필요) ---
# 1. Firebase Service Account Key (Base64 인코딩 값)
# 발급처: Google Cloud Console -> IAM 및 관리자 -> 서비스 계정 -> 키 생성(JSON)
# 터미널에서 `base64 -w 0 <다운로드된키.json>` 실행 후 그 결과를 입력하세요.
FIREBASE_SERVICE_ACCOUNT_KEY=

# 2. Firebase VAPID Key (Web Push 권한 식별자)
# 발급처: Firebase Console -> 프로젝트 설정 -> 클라우드 메시징 탭 -> 웹 구성(Web Push certificates)에서 키 쌍 생성
VAPID_KEY=

# 3. 선박 출항/접안 시간 변경 알림 기준 (분 단위, 기본값: 60분 = 1시간 이상 변동 시 알림 발송)
SCHEDULE_DIFF_THRESHOLD_MINUTES=60

# 4. API 호출을 허용할 추가 출처 (쉼표 구분, 미지정 시 운영 도메인만 허용)
#    예: ALLOWED_ORIGINS=https://example.com,http://localhost:3111
ALLOWED_ORIGINS=

# 5. [보안] 터미널 수집 요청의 TLS 인증서 검증 해제 (기본값 0 = 검증함)
#    특정 터미널 사이트에서만 불가피할 때만 1 로 설정하고, 사유를 기록해 두세요.
TERMINAL_TLS_INSECURE=0

# 6. [보안] 화면 잠금(근무일지·상세 통계) 비밀번호 — 저장소 소스에는 절대 넣지 마세요.
#    미설정 시 기존 기본값(9445)이 사용됩니다. 반드시 다른 값으로 변경하세요.
#    Vercel: Project Settings → Environment Variables 에 등록 (plain text 아님, GitHub 시크릿 아님)
SCREEN_LOCK_PIN=

# 7. [보안] 화면 잠금 해제 토큰 서명 키 — 임의의 긴 문자열(32자 이상 권장).
#    미설정 시 SCREEN_LOCK_PIN 이 서명 키로 사용됩니다.
UNLOCK_TOKEN_SECRET=

# 7-1. [보안] 🚨 긴급 플로팅 공지 작성 비밀번호 — 저장소 소스에는 절대 넣지 마세요.
#    · 지정하면 이 값만 인정됩니다(화면 잠금 PIN 과 분리 운영).
#    · 미설정 시에는 SCREEN_LOCK_PIN 과 기본 관리자 PIN(9445) 을 함께 인정합니다.
#      (근무일지 잠금 비밀번호를 바꿔 둔 배포에서도 안내된 기본 비밀번호로 열 수 있게 하기 위함)
#    · 값을 바꾼 뒤에는 반드시 Redeploy 하세요. 빌드 시 주입되는 해시와 서버 값이 함께 갱신됩니다.
EMERGENCY_NOTICE_PIN=

# 8. [배포] 주기 작업(/api/cron/*) 트리거 인증 시크릿 — 긴 무작위 문자열 권장.
#    생성 예: `openssl rand -hex 32`
#    스케줄 감시·DB 정리·주간 백업 엔드포인트는 `Authorization: Bearer <CRON_SECRET>`
#    헤더가 이 값과 일치할 때만 실행됩니다. 미등록 시 503 으로 거부(익명 트리거 불가).
#    등록처(동일한 값을 두 곳에):
#    - Vercel: Project Settings → Environment Variables → CRON_SECRET
#      (vercel.json crons 의 매일 정리·매주 백업이 이 값으로 자동 인증됩니다)
#    - GitHub: Settings → Secrets and variables → Actions → CRON_SECRET (secret)
#      (Vercel Hobby 플랜은 매시간 크론을 금지하므로, 매시간 스케줄 감시는
#       .github/workflows/cron-schedule-watch.yml 가 이 시크릿으로 트리거합니다)
CRON_SECRET=

# 9. [알림] 일일 점검 보고서 메일 (매일 04:00 KST 자동 발송)
#    점검(Vercel Cron / node-cron) 직후 reports/daily-inspection-YYYY-MM-DD.{md,json} 을
#    첨부해 발송합니다. 전송 방식은 아래 우선순위로 **자동 감지**됩니다.
#
#    공통 설정
REPORT_EMAIL_TO=luxrank@gmail.com      # 받을 주소(쉼표로 여러 명 지정 가능)
REPORT_EMAIL_MODE=always               # always=매일 발송 / alert=WARN·FAIL 있을 때만
REPORT_EMAIL_ENABLED=1                 # 0 으로 두면 발송 자체를 끕니다
REPORT_EMAIL_ATTACHMENTS=1             # 0 으로 두면 본문만 발송(첨부 없음)
#
#    방식 A) Resend — 가장 간단 (API 키 1개, 추가 패키지 없음)
#      · https://resend.com 가입 → API Keys → Create (발신 도메인 인증 필요)
#      · REPORT_EMAIL_FROM 은 인증된 도메인 주소여야 합니다 (예: report@yourdomain.com)
RESEND_API_KEY=
REPORT_EMAIL_FROM=
#
#    방식 B) Gmail API (OAuth2) — luxrank@gmail.com 본인 계정에서 직접 발송
#      · Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID(데스크톱 앱)
#      · OAuth 동의 화면에 Gmail API(scope: https://www.googleapis.com/auth/gmail.send) 등록
#      · refresh token 발급 예: OAuth Playground (https://developers.google.com/oauthplayground)
#      · 세 값이 모두 있어야 인식됩니다. From 을 비우면 인증된 사용자 주소로 발송됩니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
#
#    방식 C) SMTP (Gmail 앱 비밀번호) — nodemailer 사용
#      · Google 계정 → 보안 → 2단계 인증 켜기 → 앱 비밀번호 생성(16자리)
#      · SMTP_USER=luxrank@gmail.com / SMTP_PASS=앱 비밀번호(공백 제거)
SMTP_HOST=                             # 예: smtp.gmail.com (비워두면 SMTP 미사용)
SMTP_PORT=465                          # 465=SSL(기본), 587=STARTTLS(SMTP_SECURE=0)
SMTP_SECURE=1                          # 465 면 1, 587 이면 0
SMTP_USER=
SMTP_PASS=
#
#    GitHub Actions(스크립트) 경로에서 발송하려면
#      · REPORT_EMAIL_ON_CLI=1 (기본 0 — Vercel Cron 과 같은 시각에 실행되므로 중복 방지)
#      · 저장소 Settings → Secrets 에 위 자격증명을 등록하고
#        .github/workflows/daily-inspection.yml 의 점검 단계 env 로 전달하세요.
REPORT_EMAIL_ON_CLI=0

# 10. [자가 점검] 주간 자가 점검 · 자가 복구 (매주 월요일 05:00 KST)
#     기능 점검 → 데이터 변화 감지 → 자동 복구 → 재검증 → 보고서 메일.
#     실행 주체: Vercel Cron(/api/cron/weekly-self-check) · node-cron(0 5 * * 1) ·
#                GitHub Actions(.github/workflows/weekly-self-check.yml)
#     모두 scripts/weekly-self-check.mjs 의 **동일한 판정 엔진**을 사용합니다.
#
#     · 자동 복구 대상은 캐시·상태·파생 보고서로 한정됩니다.
#       근무일지·게시글·선박정보 같은 원본 사용자 데이터는 읽기만 하고 수정하지 않습니다.
#     · 복구 후 재수집으로 개선 여부를 검증하고, 남은 FAIL 은 GitHub 이슈로 에스컬레이션합니다.
SELF_CHECK_ENABLED=1                    # 0 이면 주간 점검 자체를 건너뜁니다
SELF_CHECK_AUTO_FIX=1                   # 0 이면 점검만 하고 복구는 하지 않습니다(관찰 모드)
SELF_CHECK_RETRY_ATTEMPTS=2             # 터미널 재수집 횟수 (1~4)
SELF_CHECK_RETRY_BACKOFF_MS=1200        # 재시도 간 백오프(회차 × 값)
#
#     데이터 변화(드리프트) 임계값 — 지난 주 기준선 대비 비율
SELF_CHECK_DRIFT_WARN_RATIO=0.5         # 수집량이 기준선의 50% 미만이면 WARN
SELF_CHECK_DRIFT_FAIL_RATIO=0.15        # 수집량이 기준선의 15% 미만이면 FAIL
SELF_CHECK_COVERAGE_DROP_RATIO=0.5      # 핵심 필드 채움률이 절반 이하로 떨어지면 이상
#
#     보고서 메일 (전송 자격증명은 위 9번 항목의 RESEND_* / GOOGLE_* / SMTP_* 를 그대로 사용)
SELF_CHECK_EMAIL_ENABLED=1
SELF_CHECK_EMAIL_TO=luxrank@gmail.com   # 미설정 시 REPORT_EMAIL_TO → 없으면 luxrank@gmail.com
SELF_CHECK_EMAIL_MODE=always            # always=매주 / alert=PASS 가 아닐 때만
SELF_CHECK_EMAIL_ON_CLI=0               # 1 이면 GitHub Actions(CLI)에서도 발송
#
#     GitHub 이슈 에스컬레이션 (미해결 FAIL 이 있을 때 자동 생성, 선택)
#       · Vercel: 자동 주입되는 GITHUB_* 는 없으므로 필요 시 아래 두 값을 등록하세요.
#       · GitHub Actions: GITHUB_TOKEN·GITHUB_REPOSITORY 가 자동 제공됩니다(워크플로 참고).
GITHUB_TOKEN=                           # issues:write 권한 PAT (미설정 시 이슈 생성 생략)
GITHUB_REPOSITORY=luxrank-ops/BUSAN-HAK-PORT-INFO
#
#     GitHub Actions 가 점검할 배포 주소 (기본값: 운영 사이트)
SELF_CHECK_BASE_URL=https://busan-hak-port-info.vercel.app
