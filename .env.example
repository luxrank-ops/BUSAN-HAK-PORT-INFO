# Firebase Configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=busan-hak-port.firebaseapp.com
FIREBASE_PROJECT_ID=busan-hak-port
FIREBASE_STORAGE_BUCKET=busan-hak-port.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=616469111502
FIREBASE_APP_ID=1:616469111502:web:6f3c94b15e444e04c7669f
FIREBASE_MEASUREMENT_ID=G-QQ728TDFJ2


# --- 추가 알림 시스템 변수 (직접 등록 필요) ---
# 1. Firebase Service Account Key (Base64 인코딩 값)
# 발급처: Google Cloud Console -> IAM 및 관리자 -> 서비스 계정 -> 키 생성(JSON)
# 터미널에서 `base64 -w 0 <다운로드된키.json>` 실행 후 그 결과를 입력하세요.
FIREBASE_SERVICE_ACCOUNT_KEY=

# 2. Firebase VAPID Key (Web Push 권한 식별자)
# 발급처: Firebase Console -> 프로젝트 설정 -> 클라우드 메시징 탭 -> 웹 구성(Web Push certificates)에서 키 쌍 생성
VAPID_KEY=

# 3. 선박 출항/접안 시간 변경 알림 기준 (분 단위, 기본값: 60분 = 1시간 이상 변동 시 알림 발송)
SCHEDULE_DIFF_THRESHOLD_MINUTES=60

# 4. API 호출을 허용할 추가 출처 (쉼표 구분, 미지정 시 운영 도메인만 허용)
#    예: ALLOWED_ORIGINS=https://example.com,http://localhost:3111
ALLOWED_ORIGINS=

# 5. [보안] 터미널 수집 요청의 TLS 인증서 검증 해제 (기본값 0 = 검증함)
#    특정 터미널 사이트에서만 불가피할 때만 1 로 설정하고, 사유를 기록해 두세요.
TERMINAL_TLS_INSECURE=0

# 6. [보안] 화면 잠금(근무일지·상세 통계) 비밀번호 — 저장소 소스에는 절대 넣지 마세요.
#    미설정 시 기존 기본값(9445)이 사용됩니다. 반드시 다른 값으로 변경하세요.
#    Vercel: Project Settings → Environment Variables 에 등록 (plain text 아님, GitHub 시크릿 아님)
SCREEN_LOCK_PIN=

# 7. [보안] 화면 잠금 해제 토큰 서명 키 — 임의의 긴 문자열(32자 이상 권장).
#    미설정 시 SCREEN_LOCK_PIN 이 서명 키로 사용됩니다.
UNLOCK_TOKEN_SECRET=

# 7-1. [보안] 🚨 긴급 플로팅 공지 작성 비밀번호 — 저장소 소스에는 절대 넣지 마세요.
#    미설정 시 SCREEN_LOCK_PIN 과 같은 값으로 동작합니다. 별도 운영이 필요할 때만 지정하세요.
EMERGENCY_NOTICE_PIN=

# 8. [배포] 주기 작업(/api/cron/*) 트리거 인증 시크릿 — 긴 무작위 문자열 권장.
#    생성 예: `openssl rand -hex 32`
#    스케줄 감시·DB 정리·주간 백업 엔드포인트는 `Authorization: Bearer <CRON_SECRET>`
#    헤더가 이 값과 일치할 때만 실행됩니다. 미등록 시 503 으로 거부(익명 트리거 불가).
#    등록처(동일한 값을 두 곳에):
#    - Vercel: Project Settings → Environment Variables → CRON_SECRET
#      (vercel.json crons 의 매일 정리·매주 백업이 이 값으로 자동 인증됩니다)
#    - GitHub: Settings → Secrets and variables → Actions → CRON_SECRET (secret)
#      (Vercel Hobby 플랜은 매시간 크론을 금지하므로, 매시간 스케줄 감시는
#       .github/workflows/cron-schedule-watch.yml 가 이 시크릿으로 트리거합니다)
CRON_SECRET=
